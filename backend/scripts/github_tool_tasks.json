  {"id": "pr-comments", "prompt": "what did reviewers say on PR 12?", "tool": "get_pr_comments", "args": {"pr_number": 12}, "expect": "Looks good"},
  {"id": "where-defined", "prompt": "where is run_app defined?", "tool": "search_code", "args": {"query": "run_app"}, "expect": "backend/app.py"},
  {"id": "show-file", "prompt": "show me backend/app.py", "tool": "read_file", "args": {"path": "backend/app.py"}, "expect": "showing lines"},
  {"id": "list-files", "prompt": "what files exist under backend?", "tool": "list_files", "args": {"path_prefix": "backend/"}, "expect": "backend/app.py"},
  {"id": "branches", "prompt": "which branches exist?", "tool": "list_branches", "args": {}, "expect": "main (default)"},
