  {"id": "issues", "prompt": "are there open issues?", "tool": "list_issues", "args": {"state": "open"}, "expect": "Crash on save"},
  {"id": "issue-detail", "prompt": "what is issue 9 about?", "tool": "get_issue", "args": {"issue_number": 9}, "expect": "Stack trace"},
